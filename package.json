{
  "name": "anima",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "bunx trigger.dev@latest dev",
    "check": "bunx biome check src/",
    "check:fix": "bunx biome check --fix src/",
    "lint": "bunx biome lint src/",
    "lint:fix": "bunx biome lint --fix src/",
    "format": "bunx biome format --fix src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "e2b:build": "bun --env-file=.env.local e2b/build.ts anima",
    "reinstall": "rm -rf node_modules bun.lock && bun install",
    "nuclear-reset": "bun run scripts/nuclear-reset.ts",
    "x-auth": "bun run scripts/x-auth.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/node": "^10.40.0",
    "@trigger.dev/sdk": "^4.4.1",
    "@upstash/redis": "^1.36.2",
    "@upstash/vector": "^1.2.2",
    "ai": "^6.0.104",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "e2b": "^2.13.0",
    "grammy": "^1.40.1",
    "neverthrow": "^8.2.0",
    "resend": "^6.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@trigger.dev/build": "^4.4.1",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

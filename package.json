{
  "name": "anima",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "bunx trigger.dev@latest dev",
    "check": "bunx biome check src/",
    "check:fix": "bunx biome check --fix src/",
    "lint": "bunx biome lint src/",
    "lint:fix": "bunx biome lint --fix src/",
    "format": "bunx biome format --fix src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "reinstall": "rm -rf node_modules bun.lock && bun install",
    "reset": "bun run scripts/reset.ts",
    "reset:prod": "bun run scripts/reset.ts --prod",
    "dump": "bun run scripts/dump.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@daytonaio/sdk": "^0.148.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/node": "^10.42.0",
    "@trigger.dev/sdk": "4.4.3",
    "@upstash/redis": "^1.36.3",
    "@upstash/vector": "^1.2.2",
    "ai": "^6.0.114",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "elevenlabs": "^1.59.0",
    "grammy": "^1.41.1",
    "imapflow": "^1.2.12",
    "neverthrow": "^8.2.0",
    "tokenx": "^1.3.0",
    "tsdav": "^2.1.8",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@trigger.dev/build": "4.4.3",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
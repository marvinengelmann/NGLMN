# ── Environment ──
NODE_ENV=production

# ── Core AI ──
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Orchestration (Trigger.dev) ──
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxx

# ── Database (Neon Postgres) ──
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxx@ep-xxxx-xxxxxx-xxxxxxxx-pooler.x-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Cache & Memory (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=https://xxxxxx-xxx-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vector Store (Upstash Vector) ──
UPSTASH_VECTOR_REST_URL=https://xxxxxxx-xxxx-12345-xx1-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=ABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Telegram ──
TELEGRAM_BOT_TOKEN=1234567890:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_OPERATOR_CHAT_ID=12345678

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=anima@yourdomain.com
RESEND_OPERATOR_EMAIL=operator@example.com

# ── GitHub ──
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=xxxxxxxxxxxxxxx
GITHUB_REPO=xxxxx

# ── Sandbox (E2B) ──
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
E2B_TEMPLATE_ID=xxxxxxxxxxxxxxxx

# ── Weather (OpenWeather) ──
OPENWEATHER_API_KEY=ow_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENWEATHER_DEFAULT_LOCATION=Berlin

# ── Operator Settings ──
OPERATOR_TIMEZONE=Europe/Berlin
OPERATOR_PREFERRED_LANGUAGE=German

# ── MBTI Personality Type (required) ──
ANIMA_PERSONALITY_TYPE=INFP-T

# ── Monitoring (Sentry) ──
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
